PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/foodsnap
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (*.vercel.app is always allowed)
CLIENT_ORIGIN=http://localhost:5173
# Leave empty to store uploads as paths; set to the public API URL only if you
# need absolute media URLs (e.g. https://foodsnap-qwjr.onrender.com)
PUBLIC_BASE_URL=
